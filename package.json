{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.js",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --packages=external --outfile=server.js",
    "build:pages": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-force-exit tests/platform.test.ts",
    "catalogue:sync": "tsx scripts/syncCatalogueServices.ts",
    "sitemap:generate": "tsx scripts/generateSitemap.ts",
    "d1:migrate:remote": "bash scripts/applyD1Migrations.sh"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "@cloudflare/workers-types": "^5.20261113.1",
